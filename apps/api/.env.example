# API server environment. On the VPS, deploy/setup.sh generates this file (apps/api/.env) automatically.
PORT=3000
NODE_ENV=production

# Public https address of the site (used for the Telegram webhook and Mini App button)
APP_URL=

# PostgreSQL connection (both the same on a single server)
DATABASE_URL=
DIRECT_URL=

# Long random string: openssl rand -hex 32
JWT_SECRET=

# Optional: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
